# Copy to .env and fill in. Never commit .env.

# Required for generated answers. Without it the bot still runs and answers with cited source
# passages (extractive mode). Get a key at https://openrouter.ai/keys; :free models need no card.
OPENROUTER_API_KEY=

# Public URL of the deployment, sent to OpenRouter as the HTTP-Referer attribution header.
APP_URL=

# Bearer token for GET /api/admin/status. Leave empty to disable the admin endpoint.
ADMIN_TOKEN=

# Optional CRM webhook for captured leads (JSON POST). Empty = stub adapter that only logs.
CRM_WEBHOOK_URL=

# Optional contact string appended to the crawler User-Agent when running `make ingest`.
CRAWLER_CONTACT=
